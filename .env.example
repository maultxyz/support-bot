# --- Server ---
PORT=3000
DATABASE_PATH=./data/bot.db

# --- Discord ---
# Bot token from https://discord.com/developers/applications -> Bot
DISCORD_TOKEN=
# Forum channels are configured from Discord with /setup forum add
# Staff roles are configured from Discord with /setup staff add
# Forum tag names the bot applies. /setup forum add creates any that are missing.
RESOLVED_TAG_NAME=Resolved
PENDING_TAG_NAME=Pending
ADDED_TAG_NAME=Added
REJECTED_TAG_NAME=Rejected

# --- GitHub ---
# Fine-grained PAT with "Issues: Read and write" on the target repository
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_REPO=
# Any long random string. Use the same value in the repo's webhook settings.
GITHUB_WEBHOOK_SECRET=
# Comma-separated labels applied to new issues
SUPPORT_LABELS=support
FEATURE_LABELS=enhancement

# --- Sync behaviour ---
# Post Discord replies in linked threads as GitHub comments
MIRROR_DISCORD_MESSAGES=true
# Post GitHub comments into the linked Discord thread
MIRROR_GITHUB_COMMENTS=true
